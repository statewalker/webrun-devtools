{
  "name": "@statewalker/webrun-devtools",
  "description": "DevTools Extension for the StateWalker WebRun framework",
  "bugs": {
    "url": "https://github.com/statewalker/webrun-devtools/issues"
  },
  "version": "0.1.5",
  "protocolVersion": 0.1,
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "homepage": "https://github.com/statewalker/webrun-devtools#readme",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "module": "dist/webrun-devtools.js",
  "main": "dist/webrun-devtools.js",
  "scripts": {
    "dev": "tsc && nodemon",
    "build": "rm -rf dist && tsc && vite build --config ./vite.config.views.js && vite build --config ./vite.config.content.js && vite build --config ./vite.config.background.js && vite build --config ./vite.config.api-client.js && vite build --config ./vite.config.api-client-ws.js",
    "zip": "pnpm run build && cd ./dist/webrun-devtools-extension && zip -r ../webrun-devtools-extension.zip .",
    "typecheck": "tsc",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "changeset": "changeset"
  },
  "files": [
    "dist/*.js",
    "dist/*.zip",
    "docs/**",
    "src/**",
    "examples/**",
    "README.md"
  ],
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "@statewalker/getset": "catalog:",
    "@statewalker/utils": "catalog:",
    "@statewalker/webrun-http": "catalog:",
    "@statewalker/webrun-ports": "catalog:",
    "idb-keyval": "catalog:",
    "nodemon": "catalog:",
    "open-props": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/webrun-devtools.git"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "semver": "catalog:"
  }
}
